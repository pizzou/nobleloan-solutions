# ================================================================
# Noble Loan Solutions Ltd — Loan Platform
# Single-tenant deployment. Copy this file to .env and fill in real
# values. NEVER commit .env to version control.
#
# Tip: run ./deploy/scripts/generate-secrets.sh to auto-generate strong,
# unique values for JWT_SECRET, APP_ENCRYPTION_KEY, APP_INDEX_KEY,
# BACKUP_ENCRYPTION_KEY, and a suggested BOOTSTRAP_ADMIN_PASSWORD — instead
# of making these up by hand. It won't generate MAIL_* or FLUTTERWAVE_*
# values since those come from real accounts, not randomness.
# ================================================================

# ---- Database ----
DB_PASSWORD=

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRATION_MS=900000

# ---- Runtime environment ----
APP_ENVIRONMENT=production

# ---- Spring Profile ----
SPRING_PROFILE=default

# ---- CORS (comma-separated) ----
# This bank's public domain(s) only. Normal browser traffic goes through
# nginx same-origin and doesn't need this, but it matters for direct API
# access (Swagger from an office IP, future mobile apps, etc).
CORS_ORIGINS=https://nobleloansolutions.rw,https://www.nobleloansolutions.rw
WEBSOCKET_ALLOWED_ORIGINS=https://nobleloansolutions.rw,https://www.nobleloansolutions.rw
FRONTEND_URL=https://nobleloansolutions.rw
PUBLIC_TENANT_SLUG=nobleloansolutions
PUBLIC_REGISTRATION_ENABLED=false

# ---- Frontend API URL ----
NEXT_PUBLIC_API_URL=/api
# Server-side Next.js backend target inside the AOS Docker network. Do not expose this hostname to the browser.
BACKEND_API_URL=http://backend:8080/api

# ---- Email (Brevo HTTP API) ----
# MailService uses Brevo over HTTPS. SMTP variables are not used by the application.
MAIL_ENABLED=true
BREVO_API_KEY=REPLACE_WITH_REAL_BREVO_API_KEY
MAIL_FROM=
MAIL_FROM_NAME=Noble Loan Solution

# ---- Production go-live bootstrap (REQUIRED before real customer data) ----
# Production must set the bootstrap administrator variables below.
# Never deploy production with development/demo seed credentials.
# Set all bootstrap variables before going live to get one real organization and one real
# admin account instead, with no demo borrowers/loans/payments created at all.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_COUNTRY=
BOOTSTRAP_ORG_CURRENCY=
BOOTSTRAP_ORG_TIMEZONE=Africa/Kigali
BOOTSTRAP_ORG_LOCALE=en-RW
BOOTSTRAP_ORG_SLUG=nobleloansolutions
BOOTSTRAP_ORG_PUBLIC_DOMAIN=nobleloansolutions.rw
BOOTSTRAP_ORG_WEBSITE=
BOOTSTRAP_ORG_CONTACT_EMAIL=
BOOTSTRAP_ORG_CONTACT_PHONE=
BOOTSTRAP_ORG_ADDRESS=
BOOTSTRAP_ORG_REGISTRATION_NUMBER=
BOOTSTRAP_ORG_PRIMARY_COLOR=#0F1B3D
BOOTSTRAP_ORG_ACCENT_COLOR=#C9A227
BOOTSTRAP_ORG_FOUNDED_YEAR=
BOOTSTRAP_ORG_FACEBOOK_URL=
BOOTSTRAP_ORG_INSTAGRAM_URL=
BOOTSTRAP_ORG_LINKEDIN_URL=
BOOTSTRAP_ORG_TWITTER_URL=
BOOTSTRAP_ORG_WHATSAPP_URL=
BOOTSTRAP_ORG_MAP_URL=

# ---- PII field-level encryption (REQUIRED for docker-compose deploy) ----
# Generate each with: openssl rand -base64 32
# APP_ENCRYPTION_KEY encrypts sensitive fields (national ID, phone, address, spouse
# info, bank account) at rest — actual ciphertext in the database, not just access
# control. APP_INDEX_KEY is a SEPARATE key used only to compute lookup hashes (so a
# returning borrower can still be found by phone/national ID without storing them
# in plaintext or a reversible form). Losing either key permanently loses access to
# the data it protects — store them in a secrets manager once you're in production,
# not just this file.
APP_ENCRYPTION_KEY=
APP_INDEX_KEY=

# ---- Flutterwave Payments ----
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "Secret Hash" from Settings > Webhooks in your Flutterwave dashboard —
# verifies incoming webhook calls at /api/public/webhooks/flutterwave are
# genuinely from Flutterwave, not spoofed.
FLUTTERWAVE_WEBHOOK_SECRET=

# ---- Open Exchange Rates (FX) ----
OXR_APP_ID=your_openexchangerates_app_id

# ---- SSL Domain (for Let's Encrypt via deploy/scripts/ssl-init.sh) ----
#   ./deploy/scripts/ssl-init.sh admin@nobleloansolutions.rw nobleloansolutions.rw www.nobleloansolutions.rw
DOMAIN=nobleloansolutions.rw
EMAIL=admin@nobleloansolutions.rw

# ---- Optional direct mobile-money providers ----
# Enable only after the provider contract, production credentials, callbacks and webhook
# verification have been tested end-to-end.
MTN_MOMO_ENABLED=false
MTN_MOMO_SANDBOX=false
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_WEBHOOK_SECRET=

AIRTEL_MONEY_ENABLED=false
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_CALLBACK_URL=
AIRTEL_MONEY_WEBHOOK_SECRET=

# ---- Real credit bureau ----
CREDIT_BUREAU_ENABLED=true
CREDIT_BUREAU_BASE_URL=
CREDIT_BUREAU_API_KEY=
CREDIT_BUREAU_REQUIRED_FOR_DISBURSEMENT=true

# ---- External KYC/AML / sanctions provider ----
# Production compliance must use a licensed provider; the internal placeholder is not
# accepted as a real clearance. The exact API contract must be mapped once the provider
# supplies its production documentation.
COMPLIANCE_EXTERNAL_PROVIDER_ENABLED=true
COMPLIANCE_PROVIDER=REPLACE_WITH_LICENSED_PROVIDER
COMPLIANCE_BASE_URL=https://provider.example.com
COMPLIANCE_API_KEY=REPLACE_WITH_REAL_PROVIDER_KEY
COMPLIANCE_WEBHOOK_SECRET=

# ---- Disaster recovery ----
BACKUP_ENVIRONMENT=production
BACKUP_ENCRYPTION_KEY=
BACKUP_REMOTE_CMD=

# The production backup script refuses to run until this contains a safe upload
# command with a literal {file} placeholder. Example pattern: rclone copy {file} remote:loansaas/

# ---- SMS (at least one production provider is required) ----
SMS_ENABLED=true
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Synthetic monitoring ----
NOBLE_LOAN_API_BASE_URL=https://nobleloansolutions.rw

# ---- Regulatory provisioning policy (must be approved before production) ----
PROVISIONING_POLICY_APPROVED=false
PROVISION_RATE_CURRENT=0
PROVISION_RATE_WATCH=0
PROVISION_RATE_SUBSTANDARD=0
PROVISION_RATE_DOUBTFUL=0
PROVISION_RATE_WRITTEN_OFF=0
AUTH_COOKIE_SAME_SITE=Lax

# ---- Production evidence gates ----
# Each must be set to true only after the corresponding evidence/approval exists.
# The application refuses to start in production while any mandatory gate is false.
PROD_GATE_PENTEST_APPROVED=false
PROD_GATE_IDOR_AUDIT_APPROVED=false
PROD_GATE_CORS_VERIFIED=false
PROD_GATE_SECRET_MANAGER_CONFIGURED=false
PROD_GATE_BNR_LICENSE_CONFIRMED=false
PROD_GATE_REGULATION_MAPPING_APPROVED=false
PROD_GATE_LEGAL_DISCLOSURES_APPROVED=false
PROD_GATE_PENALTY_POLICY_APPROVED=false
PROD_GATE_DPO_REGISTERED=false
PROD_GATE_DPO_APPOINTED=false
PROD_GATE_RECORDS_PROCESSING_APPROVED=false
PROD_GATE_DPIA_APPROVED=false
PROD_GATE_RETENTION_APPROVED=false
PROD_GATE_BREACH_PLAN_APPROVED=false
PROD_GATE_BACKUP_RESTORE_DRILL_APPROVED=false
PROD_GATE_POSTGRES_HA_APPROVED=false
PROD_GATE_UPTIME_MONITORING_APPROVED=false
PROD_GATE_CENTRAL_ALERTING_APPROVED=false
PROD_GATE_ACCOUNTING_CLOSE_APPROVED=false
PROD_GATE_COA_APPROVED=false
PROD_GATE_BANK_RECON_APPROVED=false
PROD_GATE_SUBLEDGER_RECON_APPROVED=false
PROD_GATE_REVENUE_POLICY_APPROVED=false
PROD_GATE_GOLDEN_SCENARIOS_APPROVED=false
PROD_GATE_CONCURRENCY_TESTED=false
PROD_GATE_PRODUCTION_POSTGRES_TESTED=false
PROD_GATE_REGULATORY_GOLDEN_APPROVED=false
