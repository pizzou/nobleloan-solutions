{
  "name": "loansaas-pro-ui",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "typecheck": "tsc --noEmit",
    "lint:ci": "node ./node_modules/next/dist/bin/next lint --max-warnings=0",
    "verify": "npm run verify:deps && npm run verify:security && npm run typecheck && npm run lint:ci && npm run build",
    "verify:deps": "node ./scripts/verify-frontend-deps.cjs",
    "verify:security": "node ./scripts/verify-security-posture.cjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "next": "14.2.35",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "recharts": "^2.12.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sockjs-client": "1.5.4",
    "autoprefixer": "10.5.4",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
